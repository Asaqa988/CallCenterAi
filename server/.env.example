# pipecat-arabic-test - Environment Variables
# Copy this file to .env and fill in your API key.
# The whole bot (listening, thinking, speaking) runs on one Google Gemini key.

GOOGLE_API_KEY=

# Optional overrides. Leave empty to use the defaults.
# LLM, default: gemini-3.8-flash
GOOGLE_MODEL=
# Voice model, default: gemini-3.8-flash-tts
GEMINI_TTS_MODEL=
# Voice name, default: Kore
GEMINI_VOICE=

# Optional: n8n webhook that saves the questions the bot could not answer.
# Leave empty to turn it off. See DEPLOY.md.
N8N_UNANSWERED_WEBHOOK_URL=

# The bot can scroll and highlight things on the web page while it talks (see ui_tools.py).
#   auto  (default): a small background model picks the page action in parallel with the
#                    answer, so there is no extra silence.
#   tools: the voice model calls the page tools itself and gets a hint back, but every
#          answer takes one more model round trip (about 2 seconds more silence).
#   0: do not drive the page.
UI_TOOLS=auto
# Model for the auto mode's page router. Default: gemini-3.1-flash-lite (about 0.8 s).
GOOGLE_ROUTER_MODEL=
