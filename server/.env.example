# pipecat-arabic-test - Environment Variables
# Copy this file to .env and fill in your API key.
# The whole bot (listening, thinking, speaking) runs on one Google Gemini key.

GOOGLE_API_KEY=

# Optional overrides. Leave empty to use the defaults.
# LLM, default: gemini-3.8-flash
GOOGLE_MODEL=
# Voice model, default: gemini-3.8-flash-tts
GEMINI_TTS_MODEL=
# Voice name, default: Kore
GEMINI_VOICE=

# Optional: n8n webhook that saves the questions the bot could not answer.
# Leave empty to turn it off. See DEPLOY.md.
N8N_UNANSWERED_WEBHOOK_URL=
